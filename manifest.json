{
  "manifest_version": 3,
  "name": "nospopo",
  "version": "1.0.0",
  "description": "Removes podcasts and audiobooks from the Spotify web player home page and sidebar.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://open.spotify.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "nospopo",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "css": ["src/content/filter.css"],
      "js": ["src/shared/rules.js", "src/content/filter.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
